# Public URL used for self-referential links and callbacks.
APP_URL=http://localhost:3000

# Blockchain Node Configuration
# NODE_ID: Unique identifier for this server instance
NODE_ID=beyondbound-local
# PEER_NODES: Comma-separated list of other node URLs (e.g. http://1.2.3.4:3000,http://5.6.7.8:3000)
PEER_NODES=

# Public API safety limits
JSON_BODY_LIMIT=2mb
API_MUTATION_RATE_LIMIT=120
WS_MAX_PAYLOAD_BYTES=1048576
