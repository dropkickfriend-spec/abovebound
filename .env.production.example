# Copy this file to .env.production on the AWS server. Never commit the real file.

# Required after creating the remotely managed tunnel in Cloudflare.
TUNNEL_TOKEN=

# Server identity and optional comma-separated BeyondBound peer origins.
NODE_ID=abovebound-aws-1
PEER_NODES=

# Maximum JSON request size accepted by the public API.
JSON_BODY_LIMIT=2mb
API_MUTATION_RATE_LIMIT=120
WS_MAX_PAYLOAD_BYTES=1048576
